{
  "artifacts": [
    {
      "path": "data/detections.json",
      "producer_command": "current released raw input",
      "claim_labels": ["claim:rules-full-corpus"],
      "category": "evaluation-input",
      "note": "15,718 full-corpus detection records."
    },
    {
      "path": "data/patches_rules_full.json.gz",
      "producer_command": "current released raw input",
      "claim_labels": ["claim:rules-full-corpus", "claim:verified-patch-evidence"],
      "category": "pipeline-output",
      "note": "13,656 deterministic full-corpus patch records."
    },
    {
      "path": "data/verified_rules_full.json.gz",
      "producer_command": "current released raw input",
      "claim_labels": ["claim:rules-full-corpus", "claim:verified-patch-evidence", "claim:taxonomy-historical-records"],
      "category": "pipeline-output",
      "note": "13,656 full-corpus verifier decisions, including 13,589 accepted records."
    },
    {
      "path": "data/metrics_rules_full.json",
      "producer_command": "python -m src.eval.metrics --detections data/detections.json --patches data/patches_rules_full.json --verified data/verified_rules_full.json --out data/metrics_rules_full.json",
      "claim_labels": ["claim:rules-full-corpus"],
      "category": "evaluation-metrics",
      "note": "Canonical full-corpus metrics, exactly checked against the raw gzip inputs."
    },
    {
      "path": "data/eval/unified_eval_summary.json",
      "producer_command": "make reproducible-report",
      "claim_labels": ["claim:rules-full-corpus", "claim:grok5k-acceptance", "claim:paper-table-consistency"],
      "category": "evaluation-summary",
      "note": "Unified table source for paper acceptance rows."
    },
    {
      "path": "data/outputs/batch_runs/grok_5k/metrics_grok5k.json",
      "producer_command": "archived Grok-5k campaign metrics",
      "claim_labels": ["claim:grok5k-acceptance", "claim:matched-mode-comparison"],
      "category": "evaluation-metrics",
      "note": "Archived Grok/xAI 5k metrics."
    },
    {
      "path": "data/metrics_rules_5000.json",
      "producer_command": "archived matched rules-5k campaign metrics",
      "claim_labels": ["claim:matched-mode-comparison"],
      "category": "evaluation-metrics",
      "note": "Archived rules+guardrails metrics on the matched 5k input."
    },
    {
      "path": "data/baselines/mode_comparison.csv",
      "producer_command": "derive from data/metrics_rules_5000.json and data/batch_runs/grok_5k/metrics_grok5k.json",
      "claim_labels": ["claim:matched-mode-comparison"],
      "category": "figure-input",
      "note": "Two-row matched-corpus comparison with explicit source metrics."
    },
    {
      "path": "figures/mode_comparison.png",
      "producer_command": "python scripts/plot_mode_comparison.py",
      "claim_labels": ["claim:matched-mode-comparison"],
      "category": "paper-figure",
      "note": "Rendered matched 5k comparison."
    },
    {
      "path": "data/live_cluster/results_1k.json",
      "producer_command": "make live-eval",
      "claim_labels": ["claim:live-cluster-success"],
      "category": "live-cluster-evidence",
      "note": "Live-cluster 1k replay results."
    },
    {
      "path": "data/verified_rules_supported.json",
      "producer_command": "historical supported verifier snapshot",
      "claim_labels": ["claim:scheduler-static-priority", "claim:taxonomy-historical-records"],
      "category": "scheduler-input",
      "note": "Historical 1,278-record supported verifier snapshot with 1,259 accepted records."
    },
    {
      "path": "data/detections_supported.json",
      "producer_command": "historical supported detection snapshot",
      "claim_labels": ["claim:scheduler-static-priority"],
      "category": "scheduler-input",
      "note": "Detection order and policy identifiers for the matched replay."
    },
    {
      "path": "data/policy_metrics.json",
      "producer_command": "historical policy-prior snapshot",
      "claim_labels": ["claim:scheduler-static-priority"],
      "category": "scheduler-input",
      "note": "Historical pass priors and configured 10-minute service-time fallbacks; wait and exploration are zero."
    },
    {
      "path": "data/metrics_schedule_compare.json",
      "producer_command": "make benchmark-scheduler",
      "claim_labels": ["claim:scheduler-static-priority"],
      "category": "scheduler-metrics",
      "note": "Exact static risk-priority versus FIFO replay, regenerated by metrics-consistency."
    },
    {
      "path": "figures/fairness_waits.png",
      "producer_command": "python scripts/plot_scheduler_waits.py",
      "claim_labels": ["claim:scheduler-static-priority"],
      "category": "paper-figure",
      "note": "Top-50 median/P95 waits; the filename is retained for compatibility."
    },
    {
      "path": "data/failures/taxonomy_counts.csv",
      "producer_command": "python scripts/aggregate_failure_taxonomy.py",
      "claim_labels": ["claim:taxonomy-historical-records"],
      "category": "taxonomy-metrics",
      "note": "Cohort provenance, denominators, rejected-record category counts, and raw error-event counts."
    },
    {
      "path": "data/eval/table4_counts.csv",
      "producer_command": "python scripts/eval_confidence.py",
      "claim_labels": ["claim:paper-table-consistency"],
      "category": "paper-table-input",
      "note": "Acceptance count inputs for the paper evaluation table."
    },
    {
      "path": "data/eval/table4_with_ci.csv",
      "producer_command": "python scripts/eval_confidence.py",
      "claim_labels": ["claim:paper-table-consistency"],
      "category": "paper-table-output",
      "note": "Wilson interval table for paper evaluation rows."
    },
    {
      "path": "data/eval/significance_tests.json",
      "producer_command": "python scripts/eval_significance.py",
      "claim_labels": ["claim:paper-table-consistency"],
      "category": "paper-table-output",
      "note": "Acceptance-rate significance statistics for paper rows."
    },
    {
      "path": "data/patches.json",
      "producer_command": "make propose",
      "claim_labels": ["claim:verified-patch-evidence"],
      "category": "pipeline-output",
      "note": "Generated patch candidates for the default sample pipeline."
    },
    {
      "path": "data/verified.json",
      "producer_command": "make verify",
      "claim_labels": ["claim:verified-patch-evidence"],
      "category": "pipeline-output",
      "note": "Verifier decisions for the default sample pipeline."
    }
  ]
}
