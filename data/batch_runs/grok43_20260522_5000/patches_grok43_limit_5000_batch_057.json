[
  {
    "id": "01426",
    "policy_id": "run_as_non_root",
    "source": "grok",
    "hardened": true,
    "patch": [
      {
        "op": "add",
        "path": "/spec/schedule",
        "value": "0 0 * * *"
      },
      {
        "op": "add",
        "path": "/spec/jobTemplate/spec",
        "value": {
          "template": {
            "spec": {
              "containers": [
                {
                  "image": "public.ecr.aws/m3i7d4x6/ecr-refresh:stable",
                  "name": "ecr-refresh",
                  "env": [
                    {
                      "name": "AWS_REGION",
                      "valueFrom": {
                        "configMapKeyRef": {
                          "name": "ecr-refresh",
                          "key": "aws_region"
                        }
                      }
                    },
                    {
                      "name": "AWS_ACCESS_KEY_ID",
                      "valueFrom": {
                        "configMapKeyRef": {
                          "name": "ecr-refresh",
                          "key": "aws_access_key_id"
                        }
                      }
                    },
                    {
                      "name": "AWS_SECRET_ACCESS_KEY",
                      "valueFrom": {
                        "secretKeyRef": {
                          "name": "aws-secret-access-key-secret",
                          "key": "aws_secret_access_key"
                        }
                      }
                    }
                  ],
                  "volumeMounts": [
                    {
                      "name": "config",
                      "mountPath": "/config",
                      "readOnly": true
                    }
                  ],
                  "securityContext": {
                    "runAsNonRoot": true,
                    "privileged": false,
                    "capabilities": {
                      "drop": [
                        "ALL",
                        "NET_RAW",
                        "NET_ADMIN",
                        "SYS_ADMIN",
                        "SYS_MODULE",
                        "SYS_PTRACE",
                        "SYS_CHROOT"
                      ]
                    },
                    "allowPrivilegeEscalation": false,
                    "readOnlyRootFilesystem": true
                  },
                  "resources": {
                    "requests": {
                      "cpu": "100m",
                      "memory": "128Mi"
                    },
                    "limits": {
                      "cpu": "500m",
                      "memory": "256Mi"
                    }
                  }
                }
              ],
              "serviceAccountName": "svc-ecr-refresh",
              "volumes": [
                {
                  "name": "config",
                  "configMap": {
                    "name": "ecr-refresh",
                    "items": [
                      {
                        "key": "application.yml",
                        "path": "application.yml"
                      }
                    ]
                  }
                }
              ],
              "restartPolicy": "OnFailure"
            }
          }
        }
      },
      {
        "op": "remove",
        "path": "/spec/jobTemplate/template"
      },
      {
        "op": "replace",
        "path": "/apiVersion",
        "value": "batch/v1"
      }
    ],
    "attempt_count": 3,
    "retry_budget": 3,
    "latency_ms": 8554,
    "total_latency_ms": 8554,
    "attempt_errors": [
